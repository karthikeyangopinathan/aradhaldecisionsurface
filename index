function curve(x0,y0,x1,y1){const mx=(x0+x1)/2,my=(y0+y1)/2;const pull=LENS==='arc'?.22:0;
  const cxp=mx+(cx-mx)*pull, cyp=my+(cy-my)*pull*.35+(LENS==='arc'?30:0);return `M ${x0} ${y0} Q ${cxp} ${cyp} ${x1} ${y1}`}
function topPairs(k){const all=[];Object.keys(PAIRS).forEach(key=>{const [a,b]=key.split('-').map(Number);const s=pairScore(a,b);if(s>0)all.push({a,b,s});});
  all.sort((x,y)=>y.s-x.s||(byId[x.a].age+byId[x.b].age)-(byId[y.a].age+byId[y.b].age));return all.slice(0,k)}
function drawLinks(){
  clear(gLinks);
