function deOverlap(items,gap,lo,hi){
  items.sort((a,b)=>a.target-b.target);let prev=-1e9;
  items.forEach(it=>{let p=Math.max(it.target,prev+gap);it.pos=p;prev=p;});
  const over=items.length?items[items.length-1].pos-hi:0;if(over>0)items.forEach(it=>it.pos-=over);
  if(items.length&&items[0].pos<lo){const d=lo-items[0].pos;items.forEach(it=>it.pos+=d);}
}
