<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Aradhal · Decision Surface</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1b1b1a; --ink-soft:#5f5d58; --ink-faint:#9a978f;
    --paper:#ffffff; --panel:#fbfaf7; --hair:#e9e6df; --hair-strong:#dcd8cf;
    --signal:#F7941E; --signal-ink:#b5650a;
    --founder:#F7941E; --observed:#3FA845; --mentor:#b4ac9f;
    --s0:#16C2B3;--s1:#3B82E0;--s2:#4FB63C;--s3:#AEBE1C;--s4:#F7941E;--s5:#EA3B2E;--s6:#EC4899;--s7:#7C4DD6;
    font-synthesis:none;
  }
  *{box-sizing:border-box}
  html,body{margin:0;background:var(--paper);color:var(--ink);
    font-family:"Figtree",ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
    -webkit-font-smoothing:antialiased}
  body{line-height:1.45}
  .wrap{max-width:1300px;margin:0 auto;padding:26px 24px 72px}

  header.top{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;
    border-bottom:1px solid var(--hair);padding-bottom:16px;flex-wrap:wrap}
  .brand{display:flex;align-items:baseline;gap:12px}
  .mark{width:40px;height:20px;flex:none}
  h1{font-size:19px;font-weight:800;margin:0;letter-spacing:-.01em}
  .sub{color:var(--ink-soft);font-size:13.5px;margin:4px 0 0;max-width:70ch}
  .lenswitch{display:flex;border:1px solid var(--hair-strong);border-radius:999px;overflow:hidden;background:var(--paper)}
  .lenswitch button{appearance:none;border:0;background:transparent;font:inherit;font-weight:600;
    font-size:13px;color:var(--ink-soft);padding:8px 15px;cursor:pointer}
  .lenswitch button[aria-pressed="true"]{background:var(--ink);color:#fff}
  .lenswitch button:focus-visible{outline:2px solid var(--signal);outline-offset:-2px}

  .grid{display:grid;grid-template-columns:1fr 340px;gap:26px;margin-top:20px}
  @media(max-width:960px){.grid{grid-template-columns:1fr}}

  .stage{position:relative;background:var(--paper);border:1px solid var(--hair);border-radius:14px;overflow:hidden}
  .stage svg{display:block;width:100%;height:auto}
  .hint{position:absolute;left:16px;bottom:12px;font-size:12px;color:var(--ink-faint)}

  aside{display:flex;flex-direction:column;gap:16px}
  .card{background:var(--panel);border:1px solid var(--hair);border-radius:14px;padding:15px 15px 17px}
  .card h2{font-size:12.5px;font-weight:800;letter-spacing:.01em;color:var(--ink-soft);margin:0 0 11px}
  .kicker{font-size:11.5px;color:var(--ink-faint);margin:0 0 9px}

  .toggles{display:flex;flex-direction:column;gap:5px}
  .tgl{display:flex;align-items:flex-start;gap:9px;cursor:pointer;padding:7px 8px;border-radius:9px;border:1px solid transparent}
  .tgl:hover{background:#fff;border-color:var(--hair)}
  .tgl.disabled{opacity:.4;cursor:not-allowed}
  .tgl input{appearance:none;width:16px;height:16px;border-radius:5px;border:1.5px solid var(--hair-strong);
    display:grid;place-content:center;flex:none;cursor:pointer;background:#fff;margin-top:1px;transition:.12s}
  .tgl input:checked{background:var(--c,var(--ink));border-color:var(--c,var(--ink))}
  .tgl input:checked::after{content:"";width:8px;height:8px;border-radius:2px;background:#fff}
  .tgl input:focus-visible{outline:2px solid var(--signal);outline-offset:2px}
  .tgl .lab{font-size:13px;font-weight:600}
  .tgl .desc{font-size:11px;color:var(--ink-faint);display:block;font-weight:400;margin-top:1px;line-height:1.35}
  .swatch{width:9px;height:9px;border-radius:50%;flex:none;background:var(--c);margin-top:4px}

  .sublogic{margin:9px 0 0;padding:11px 0 2px;border-top:1px dashed var(--hair-strong)}
  .sublogic.off{opacity:.4;pointer-events:none}

  .pair{display:block;width:100%;text-align:left;appearance:none;border:1px solid var(--hair);background:#fff;
    border-radius:11px;padding:10px 11px;cursor:pointer;font:inherit;margin-bottom:8px;transition:.12s}
  .pair:hover{border-color:var(--hair-strong);transform:translateY(-1px)}
  .pair:focus-visible{outline:2px solid var(--signal);outline-offset:2px}
  .pair[aria-current="true"]{border-color:var(--ink);box-shadow:0 0 0 1px var(--ink)}
  .pair .names{font-size:13px;font-weight:700;display:flex;align-items:center;gap:6px;flex-wrap:wrap}
  .pair .dot{width:8px;height:8px;border-radius:50%;flex:none}
  .pair .why{font-size:11.5px;color:var(--ink-soft);margin-top:4px;line-height:1.4}
  .score-chip{margin-left:auto;font-size:11px;font-weight:800;color:var(--signal-ink);
    background:#fff4e6;border:1px solid #fbe0bf;border-radius:999px;padding:2px 8px;white-space:nowrap}
  .rank{font-size:11px;color:var(--ink-faint);font-weight:800;margin-right:1px}

  #detail .empty,.empty{font-size:12.5px;color:var(--ink-faint)}
  .node-title{display:flex;align-items:center;gap:9px;font-size:15px;font-weight:800;margin:0 0 2px}
  .node-title .dot{width:12px;height:12px;border-radius:50%;flex:none}
  .meta{font-size:12px;color:var(--ink-soft);margin:0 0 9px}
  .desc-line{font-size:12.5px;color:var(--ink);margin:0 0 12px;line-height:1.45}
  .mini{font-size:11px;color:var(--ink-faint);font-weight:800;margin:0 0 6px;letter-spacing:.01em}
  .chips{display:flex;flex-wrap:wrap;gap:5px;margin:0 0 13px}
  .chip{font-size:11px;font-weight:600;border:1px solid var(--hair-strong);background:#fff;border-radius:999px;
    padding:2px 9px;color:var(--ink-soft);cursor:pointer}
  .chip:hover{border-color:var(--ink)}
  .role-tag{display:inline-block;font-size:11px;font-weight:700;border-radius:6px;padding:2px 8px;margin-bottom:12px}
  .bars{display:flex;flex-direction:column;gap:7px;margin-bottom:11px}
  .bar-row{display:grid;grid-template-columns:110px 1fr 46px;align-items:center;gap:8px;font-size:11.5px}
  .bar-track{height:7px;border-radius:4px;background:#efece5;overflow:hidden}
  .bar-fill{height:100%;border-radius:4px}
  .bar-val{font-size:11px;color:var(--ink-faint);text-align:right;font-weight:700;display:flex;align-items:center;justify-content:flex-end;gap:4px}
  .stp{appearance:none;border:1px solid var(--hair-strong);background:#fff;width:17px;height:17px;border-radius:5px;
    font:inherit;font-size:12px;line-height:1;cursor:pointer;color:var(--ink-soft);padding:0}
  .stp:hover{border-color:var(--ink);color:var(--ink)}
  .verdict{font-size:12px;color:var(--ink);background:#fff;border:1px solid var(--hair);
    border-left:3px solid var(--signal);border-radius:8px;padding:9px 11px;line-height:1.45}
  .coup-list{list-style:none;margin:6px 0 0;padding:0;display:flex;flex-direction:column;gap:6px}
  .coup-list button{all:unset;cursor:pointer;display:flex;gap:8px;align-items:flex-start;font-size:12px;
    padding:6px 7px;border-radius:8px;border:1px solid transparent}
  .coup-list button:hover{background:#fff;border-color:var(--hair)}
  .coup-list .ct{font-weight:700}.coup-list .cd{color:var(--ink-faint)}

  /* coverage */
  .cov-row{display:grid;grid-template-columns:1fr auto;gap:6px 10px;align-items:center;padding:7px 0;border-top:1px solid var(--hair)}
  .cov-row:first-of-type{border-top:0}
  .cov-name{font-size:12px;font-weight:700}
  .cov-sub{font-size:10.5px;color:var(--ink-faint);font-weight:500}
  .cov-metrics{display:flex;align-items:center;gap:8px}
  .heat{width:56px;height:7px;border-radius:4px;background:#efece5;overflow:hidden}
  .heat i{display:block;height:100%;background:var(--founder);border-radius:4px}
  .supply-dots{display:flex;gap:3px}
  .supply-dots span{width:7px;height:7px;border-radius:50%;background:var(--ink);opacity:.8}
  .supply-dots span.empty{background:transparent;border:1px solid var(--hair-strong)}
  .flag{font-size:10px;font-weight:800;color:#fff;background:var(--signal);border-radius:5px;padding:1px 6px}
  .flag.gap{background:#c0392b}.flag.bet{background:#7C4DD6}

  /* matrix + grid */
  .board{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:26px}
  @media(max-width:960px){.board{grid-template-columns:1fr}}
  .panel{background:var(--paper);border:1px solid var(--hair);border-radius:14px;padding:16px 18px 20px}
  .panel h2{font-size:12.5px;font-weight:800;color:var(--ink-soft);margin:0}
  .panel p.lead{margin:4px 0 10px;font-size:12.5px;color:var(--ink-soft);max-width:60ch}
  .mx-scroll{overflow-x:auto}
  .legend{display:flex;align-items:center;gap:7px;font-size:11px;color:var(--ink-faint);flex-wrap:wrap}
  .legend .ramp{width:90px;height:8px;border-radius:4px;background:linear-gradient(90deg,#f3efe8,var(--signal))}
  .legend .key{display:inline-flex;align-items:center;gap:4px;margin-left:4px}
  .legend .key i{width:9px;height:9px;border-radius:2px;display:inline-block}

  .note{font-size:12px;color:var(--ink-faint);margin-top:16px;line-height:1.55}
  .note b{color:var(--ink-soft);font-weight:700}

  text{font-family:inherit}
  .n-label{font-size:12px;font-weight:600;fill:var(--ink)}
  .n-sub{font-size:10px;fill:var(--ink-faint)}
  .axis-lab{font-size:12px;font-weight:600;fill:var(--ink-soft)}
  .q-lab{font-size:11px;font-weight:700;fill:var(--ink-soft)}
  .row-lab{font-size:12px;font-weight:700;fill:var(--ink-soft)}
  .ctx-lab{font-size:10.5px;font-weight:600;fill:var(--ink-faint)}
  .age-tick{font-size:10px;fill:var(--ink-faint)}
  .stage-lab{font-size:11px;font-weight:600}
  .ll-lab{font-size:10.5px;font-weight:600;fill:var(--signal-ink)}

  .node-hit{cursor:pointer}
  .node-dot{transition:transform .15s}
  .node-hit:hover .node-dot{transform:scale(1.12)}
  .node-g{transition:transform .55s cubic-bezier(.4,0,.15,1)}
  .link{fill:none;stroke:var(--signal);transition:opacity .3s,stroke-width .3s}
  .dimmed{opacity:.3}
  @media(prefers-reduced-motion:reduce){*{transition:none !important}}
</style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <div>
      <div class="brand">
        <svg class="mark" viewBox="0 0 40 20" aria-hidden="true"><path d="M2 18 A 18 18 0 0 1 38 18" fill="none" stroke="var(--signal)" stroke-width="4" stroke-linecap="round"/></svg>
        <h1>Decision surface</h1>
      </div>
      <p class="sub">Supply (12 venture pieces) over demand (your 49 clusters, coalesced to 8 themes) over the value chain. One quiet base; every overlay is opt-in. Switch lenses to re-see the same pieces; switch layers to add meaning.</p>
    </div>
    <div class="lenswitch" role="group" aria-label="Lens">
      <button id="lensArc" aria-pressed="true">Lifespan arc</button>
      <button id="lensQuad" aria-pressed="false">Buyer quadrant</button>
      <button id="lensChain" aria-pressed="false">Value chain</button>
    </div>
  </header>

  <div class="grid">
    <section class="stage" aria-label="Venture map">
      <svg id="canvas" viewBox="0 0 1000 620" role="img" aria-label="Venture pieces placed on the current lens"></svg>
      <div class="hint" id="canvasHint">Click a piece to see what it couples with</div>
    </section>

    <aside>
      <div class="card">
        <h2>Layers</h2>
        <p class="kicker">Each adds one dimension. Default view is deliberately bare.</p>
        <div class="toggles" id="layerToggles"></div>
        <div class="sublogic" id="logicWrap">
          <p class="mini" style="margin-bottom:8px">Count a coupling only if it earns its place</p>
          <div class="toggles" id="logicToggles"></div>
        </div>
      </div>

      <div class="card" id="shortCard">
        <h2>Tandem shortlist</h2>
        <p class="kicker">Pairs only viable together, by the couplings you’ve switched on.</p>
        <div id="shortlist"></div>
      </div>

      <div class="card" id="coverageCard" style="display:none">
        <h2>Demand vs. supply</h2>
        <p class="kicker">Heat = Founder-conviction clusters. Dots = venture pieces covering it. Flags mark the mismatches.</p>
        <div id="coverage"></div>
      </div>

      <div class="card" id="detail">
        <h2 id="detailHead">Selection</h2>
        <div id="detailBody"><p class="empty">Nothing selected. Click a piece on the map, a shortlist row, or a cell in the matrix / demand grid below.</p></div>
      </div>
    </aside>
  </div>

  <div class="board">
    <div class="panel">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:14px;flex-wrap:wrap">
        <div><h2>Every pair, scored</h2><p class="lead">Each cell sums the couplings you’ve switched on. Turn on <b>Edit scores</b> to argue with them — changes recompute the shortlist and links.</p></div>
        <div class="legend">weak<span class="ramp"></span>strong</div>
      </div>
      <div class="mx-scroll"><svg id="matrix" role="img" aria-label="Coupling matrix"></svg></div>
    </div>

    <div class="panel">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:14px;flex-wrap:wrap">
        <div><h2>Your 49 clusters → 8 themes</h2><p class="lead">Rows A–F are life-stage bands; columns are the eight need-themes. Colour is your own status. Click any cell for the original cluster.</p></div>
        <div class="legend">
          <span class="key"><i style="background:var(--founder)"></i>Founder</span>
          <span class="key"><i style="background:var(--observed)"></i>Observed</span>
          <span class="key"><i style="background:var(--mentor)"></i>Mentor</span>
        </div>
      </div>
      <div class="mx-scroll"><svg id="demandGrid" role="img" aria-label="Demand grid of 49 clusters across 8 themes"></svg></div>
    </div>
  </div>

  <p class="note" id="footNote"></p>
</div>

<script>
/* ============ DATA ============ */
const STOPS=[[0,'#16C2B3'],[12,'#3B82E0'],[20,'#4FB63C'],[32,'#AEBE1C'],[44,'#F7941E'],[54,'#EA3B2E'],[66,'#EC4899'],[82,'#7C4DD6'],[95,'#5A2E9E']];
function lerp(a,b,t){return a+(b-a)*t}
function hex2rgb(h){return [parseInt(h.slice(1,3),16),parseInt(h.slice(3,5),16),parseInt(h.slice(5,7),16)]}
function rgb2hex(r){return '#'+r.map(v=>Math.round(v).toString(16).padStart(2,'0')).join('')}
function ageColor(age){age=Math.max(0,Math.min(95,age));
  for(let i=0;i<STOPS.length-1;i++){const [a0,c0]=STOPS[i],[a1,c1]=STOPS[i+1];
    if(age<=a1){const t=(age-a0)/(a1-a0),A=hex2rgb(c0),B=hex2rgb(c1);return rgb2hex([lerp(A[0],B[0],t),lerp(A[1],B[1],t),lerp(A[2],B[2],t)]);}}
  return STOPS[STOPS.length-1][1];}
function mix(c0,c1,t){const A=hex2rgb(c0),B=hex2rgb(c1);return rgb2hex([lerp(A[0],B[0],t),lerp(A[1],B[1],t),lerp(A[2],B[2],t)])}

const CHAIN={Channel:'Channel / discovery',Enabler:'Service enabler',Enhancer:'Service enhancer',Payer:'Payer-facing',Receiver:'Receiver-facing'};
const CHAIN_COLOR={Channel:'#3B82E0',Enabler:'#F7941E',Enhancer:'#7C4DD6',Payer:'#EA3B2E',Receiver:'#4FB63C'};

const NODES=[
 {id:1,short:'Discharge trigger',name:'Discharge trigger & care navigation',cluster:'Activation',age:68,fin:70,pres:80,
  role:'Channel',themes:[2,8,4],what:'Detects the hospital-discharge moment, builds the plan, routes the family into fulfilment.',
  winNote:'Fires at crisis onset — the moment the adult child is most ready to act.'},
 {id:2,short:'Clinical continuum',name:'NRI clinical continuum (subscription)',cluster:'Clinical home care',age:72,fin:85,pres:85,
  role:'Payer',themes:[2,1,4,7],what:'Ongoing subscription geriatric care managed for a distant adult child. The monetisation engine.',
  winNote:'Serves the high-pay / can’t-be-present buyer — the top-right quadrant.'},
 {id:3,short:'Home care ops',name:'Home-care & attendant operations',cluster:'Human care',age:74,fin:55,pres:78,
  role:'Enabler',themes:[2,3,7],what:'Attendants and home nursing. Labour-intensive, entirely workforce-dependent.',
  winNote:'The hands at the bedside; demand peaks where the family can’t be.'},
 {id:4,short:'Tele-physio',name:'Tele-physiotherapy',cluster:'Clinical',age:64,fin:42,pres:50,
  role:'Enhancer',themes:[4],what:'Remote preventive and rehab physio. A point service, best as a wedge inside a stack.',
  winNote:'Weak couplings alone — reads as a recurring add-on, not a company.'},
 {id:5,short:'Facility audit',name:'Facility audit & stay-booking',cluster:'Senior living',age:78,fin:80,pres:88,
  role:'Channel',themes:[2,7,8],what:'Independently vets and books senior-living and respite stays for families who can’t visit.',
  winNote:'A pure trust product for the distant buyer.'},
 {id:6,short:'Assisted living',name:'Assisted living (asset-light, Tier-2 S.)',cluster:'Senior living',age:82,fin:82,pres:45,
  role:'Payer',themes:[3,8],what:'Residential care, asset-light model in southern Tier-2 towns.',
  winNote:'Later arc; higher capital intensity even when asset-light.'},
 {id:7,short:'Age-proofing',name:'Home age-proofing',cluster:'Home & environment',age:58,fin:65,pres:40,
  role:'Enhancer',themes:[3,4],what:'Preventive home modification — the fall you design out before it happens.',
  winNote:'Preparatory; sells far more easily attached to a trigger than cold.'},
 {id:8,short:'Planning & advisory',name:'Planning & advisory',cluster:'Planning / advisory',age:55,fin:72,pres:35,
  role:'Payer',themes:[1,2,5],what:'Financial, legal, care and estate planning. Low-frequency, trust-gated — and it reaches past death.',
  winNote:'Spans prep (mid arc) and estate (post-death) — the continuation node.'},
 {id:9,short:'Trust / certification',name:'Workforce trust & certification layer',cluster:'Cross-cutting',age:48,spans:true,fin:50,pres:60,
  role:'Enabler',themes:[7,2],what:'Vets, trains and certifies the workforce. Capital-light infrastructure — your own “Service Enabler” box.',
  winNote:'Cross-cutting. The input the whole active window shares.'},
 {id:10,short:'Ageing content',name:'Relationship-to-ageing content',cluster:'Top-of-funnel',age:22,fin:20,pres:20,
  role:'Channel',themes:[5,6,1],what:'The design-research arm — the cards and lifespan material. Reaches families decades before the trigger.',
  winNote:'Early arc, pre-monetisation. Demand generation, not a sale.'},
 {id:11,short:'Adaptive clothing',name:'Adaptive clothing',cluster:'Lifestyle',age:76,fin:38,pres:30,
  role:'Receiver',themes:[3,6],what:'A standalone adaptive-apparel product.',
  winNote:'Peripheral on every coupling logic — a product, not a wedge.'},
 {id:12,short:'Engagement',name:'Lifestyle & engagement',cluster:'Lifestyle',age:70,fin:50,pres:40,
  role:'Receiver',themes:[5,6],what:'Community and loneliness programming.',
  winNote:'Best value is a retention layer, not a front door.'}
];
const byId=Object.fromEntries(NODES.map(n=>[n.id,n]));

const THEMES=[
 {id:1,name:'Funding & affordability',short:'Funding'},
 {id:2,name:'Coordination & trusted oversight',short:'Coordination'},
 {id:3,name:'Ageing-at-home & autonomy',short:'Ageing-at-home'},
 {id:4,name:'Mobility & functional prevention',short:'Mobility'},
 {id:5,name:'Emotional & psychological wellbeing',short:'Emotional'},
 {id:6,name:'Purpose, identity & contribution',short:'Purpose'},
 {id:7,name:'Provider standards, records & interop',short:'Standards/data'},
 {id:8,name:'Institutional channels',short:'Institutional'}
];
const themeById=Object.fromEntries(THEMES.map(t=>[t.id,t]));

const BANDS=[
 {b:'A',age:32,lab:'Planning adults'},{b:'B',age:45,lab:'Mid-career payers'},
 {b:'C',age:55,lab:'Dual-gen funders'},{b:'D',age:64,lab:'Young-old 60–69'},
 {b:'E',age:74,lab:'Rising-need 70–79'},{b:'F',age:84,lab:'High-acuity / frail'}];
const bandAge=Object.fromEntries(BANDS.map(x=>[x.b,x.age]));

// 49 clusters (B2b = the duplicate B2)
const CLUSTERS=[
 ['A1','A',1,'Young professionals planning for parents & self','Fund future care early','Mentor'],
 ['A2','A',2,'Outstation adult children','Know parents are okay without constant checking','Founder'],
 ['A3','A',3,'Early-career migrants with ageing parents','Support parents while preserving independence','Founder'],
 ['A4','A',4,'Children noticing early mobility decline','Act before falls or loss of function','Founder'],
 ['A5','A',5,'Children carrying guilt / worry','Discuss ageing honestly','Mentor'],
 ['A6','A',6,'Younger elders-to-be','Plan later life as contribution, not withdrawal','Founder'],
 ['A7','A',7,'Digitally comfortable family coordinators','Compare and combine reliable providers','Mentor'],
 ['A8','A',8,'Employees beginning parent-care roles','Get help without hiding family obligations','Mentor'],
 ['B1','B',1,'Adult-child payers balancing duty & career','Pay for care while preserving career mobility','Observed'],
 ['B2','B',2,'NRI / outstation adult-child payers','Verify care and handle exceptions','Founder'],
 ['B2b','B',2,'Local primary family coordinators','Share invisible work with siblings / spouse','Founder'],
 ['B3','B',3,'Parents of mid-career payers who prefer home','Accept help without losing control','Mentor'],
 ['B4','B',4,'Families managing early arthritis / recovery','Prevent avoidable loss of function','Mentor'],
 ['B5','B',5,'Sandwich-generation caregivers','Reduce guilt and overload','Mentor'],
 ['B6','B',6,'Mid-career payers seeking a positive elder future','Support interests and contribution, not only safety','Founder'],
 ['B7','B',7,'Family payers coordinating many providers','Know who is qualified and accountable','Mentor'],
 ['B8','B',8,'Employers of mid-career caregivers','Reduce disruption from parent-care crises','Mentor'],
 ['C1','C',1,'Adults funding frail parents & own ageing','Allocate money across two generations','Mentor'],
 ['C2','C',2,'Primary family caregiver nearing burnout','Coordinate family and workers reliably','Founder'],
 ['C3','C',3,'Adults planning to age at home','Prepare home and support before dependence','Founder'],
 ['C4','C',4,'Adults with emerging mobility risk','Preserve strength before later frailty','Founder'],
