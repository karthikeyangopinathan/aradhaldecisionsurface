  if(selPair)show=[{a:selPair[0],b:selPair[1],s:pairScore(selPair[0],selPair[1])}];
  else if(selNode)NODES.forEach(n=>{if(n.id===selNode)return;const s=pairScore(selNode,n.id);if(s>0)show.push({a:selNode,b:n.id,s});});
  else show=topPairs(3).map(p=>({a:p.a,b:p.b,s:p.s}));
  show.forEach(({a,b,s})=>{const ea=nodeEls[a],eb=nodeEls[b];const pd=pairData(a,b);let di=-1,dv=-1;
    LKEYS.forEach((k,i)=>{if(enabled[k]&&pd[i]>dv){dv=pd[i];di=i;}});
    const path=el('path',{class:'link',d:curve(ea._x,ea._y,eb._x,eb._y),'stroke-width':1+(s/maxS)*6,
      opacity:selPair?.9:(selNode?.2+.6*(s/maxS):.18+.35*(s/maxS))});
    if(di>=0)path.setAttribute('stroke',LOGICS[di].color);gLinks.appendChild(path);});
}

/* selection */
function clearHi(){NODES.forEach(n=>{const e=nodeEls[n.id];e.ring.setAttribute('stroke-width',n.spans?3:2.5);e.t.setAttribute('font-weight','600');e.t.setAttribute('fill','var(--ink)');});}
function selectNode(id){selNode=id;selPair=null;selTheme=null;clearHi();
  const e=nodeEls[id];e.ring.setAttribute('stroke-width',4.5);e.t.setAttribute('font-weight','700');
  NODES.forEach(n=>{if(n.id!==id)nodeEls[n.id].t.setAttribute('fill',(layer.couplings&&pairScore(id,n.id)>0)?'var(--ink)':'var(--ink-faint)');});
  document.getElementById('canvasHint').textContent='Click empty space to reset';
  layout();renderNodeDetail(id);renderShortlist();if(layer.demand)renderGrid();
}
function selectPair(a,b){selPair=[a,b];selNode=null;selTheme=null;clearHi();
  [a,b].forEach(id=>{const e=nodeEls[id];e.ring.setAttribute('stroke-width',4.5);e.t.setAttribute('font-weight','700');});
  NODES.forEach(n=>{if(n.id!==a&&n.id!==b)nodeEls[n.id].t.setAttribute('fill','var(--ink-faint)');});
  layout();renderPairDetail(a,b);renderShortlist();}
function selectTheme(tid){selTheme=tid;selNode=null;selPair=null;clearHi();
  NODES.forEach(n=>{nodeEls[n.id].t.setAttribute('fill',n.themes.includes(tid)?'var(--ink)':'var(--ink-faint)');});
  layout();renderThemeDetail(tid);renderGrid();}
function selectCluster(coord){const c=CLUSTERS.find(x=>x.coord===coord);renderClusterDetail(c);
  selTheme=c.theme;selNode=null;selPair=null;clearHi();NODES.forEach(n=>{nodeEls[n.id].t.setAttribute('fill',n.themes.includes(c.theme)?'var(--ink)':'var(--ink-faint)');});layout();renderGrid();}
function resetSel(){selNode=null;selPair=null;selTheme=null;clearHi();NODES.forEach(n=>nodeEls[n.id].t.setAttribute('fill','var(--ink)'));
  document.getElementById('canvasHint').textContent='Click a piece to see what it couples with';
  layout();document.getElementById('detailHead').textContent='Selection';
  document.getElementById('detailBody').innerHTML='<p class="empty">Nothing selected. Click a piece on the map, a shortlist row, or a cell in the matrix / demand grid below.</p>';
  renderShortlist();if(layer.demand)renderGrid();}
canvas.addEventListener('click',e=>{if(e.target===canvas)resetSel();});

/* shortlist */
function renderShortlist(){const host=document.getElementById('shortlist');host.innerHTML='';
  if(!layer.couplings){host.innerHTML='<p class="empty">Turn on the Couplings layer to rank tandems.</p>';return;}
  if(!LKEYS.some(k=>enabled[k])){host.innerHTML='<p class="empty">Switch on at least one coupling logic.</p>';return;}
  topPairs(3).forEach((p,i)=>{const A=byId[p.a],B=byId[p.b];const btn=document.createElement('button');btn.className='pair';
    btn.setAttribute('aria-current',(selPair&&selPair.includes(p.a)&&selPair.includes(p.b))?'true':'false');
    btn.innerHTML=`<div class="names"><span class="rank">${i+1}</span>
      <span class="dot" style="background:${ageColor(A.age)}"></span>${A.short}
      <span style="color:var(--ink-faint);font-weight:700">+</span>
      <span class="dot" style="background:${ageColor(B.age)}"></span>${B.short}
      <span class="score-chip">${p.s}</span></div><div class="why">${pairData(p.a,p.b)[4]}</div>`;
    btn.addEventListener('click',()=>selectPair(p.a,p.b));host.appendChild(btn);});}

/* coverage */
function renderCoverage(){const host=document.getElementById('coverage');host.innerHTML='';
  const PERIPHERAL=[4,10,11,12];
  const rows=THEMES.map(t=>{const st=themeStats[t.id];
    const onlyWeak=st.supply.length>0&&st.supply.every(n=>PERIPHERAL.includes(n.id));
    const gap=st.founder>=3&&(st.coverage<=2||onlyWeak);
    const bet=st.founder===0&&st.coverage>=1&&st.clusters.every(c=>c.status==='Mentor');
    return {t,st,gap,bet,rank:(gap?3:0)+(bet?2:0)+(st.founder>=5?1:0)};}).sort((a,b)=>b.rank-a.rank||b.st.founder-a.st.founder);
  rows.forEach(({t,st,gap,bet})=>{const row=document.createElement('div');row.className='cov-row';
    const dots=NODES.map(n=>`<span class="${n.themes.includes(t.id)?'':'empty'}"></span>`).slice(0,0);
    let supplyDots='';for(let i=0;i<Math.max(st.coverage,1);i++)supplyDots+=`<span class="${i<st.coverage?'':'empty'}"></span>`;
    row.innerHTML=`<div><div class="cov-name">${t.name}</div><div class="cov-sub">${st.founder}/${st.total} Founder-conviction · ${st.coverage} piece${st.coverage===1?'':'s'} covering</div></div>
      <div class="cov-metrics"><span class="heat" title="founder conviction"><i style="width:${(st.founder/7)*100}%"></i></span>
      <span class="supply-dots">${supplyDots}</span>
      ${gap?'<span class="flag gap">gap</span>':''}${bet?'<span class="flag bet">bet</span>':''}</div>`;
    row.style.cursor='pointer';row.addEventListener('click',()=>selectTheme(t.id));host.appendChild(row);});}

/* detail panels */
function renderNodeDetail(id){const n=byId[id];document.getElementById('detailHead').textContent='Piece';
  const partners=NODES.filter(m=>m.id!==id&&pairScore(id,m.id)>0).map(m=>({m,s:pairScore(id,m.id)})).sort((a,b)=>b.s-a.s);
  const role=n.role;
  let html=`<div class="node-title"><span class="dot" style="background:${ageColor(n.age)}"></span>${n.name}</div>
    <p class="meta">${n.cluster} · age ~${n.age} on the arc · pay ${n.fin}/100, presence-deficit ${n.pres}/100</p>
    <span class="role-tag" style="background:${mix('#ffffff',CHAIN_COLOR[role],.18)};color:${CHAIN_COLOR[role]};border:1px solid ${mix('#ffffff',CHAIN_COLOR[role],.4)}">value chain · ${CHAIN[role]}</span>
    <p class="desc-line">${n.what}</p>
    <p class="mini">Demand themes it serves</p><div class="chips">`;
  n.themes.forEach(tid=>{html+=`<span class="chip" data-theme="${tid}">${themeById[tid].short}</span>`;});
  html+=`</div><p class="mini">Where it sits</p><div class="verdict" style="border-left-color:${ageColor(n.age)};margin-bottom:13px">${n.winNote}</div>`;
  if(layer.couplings&&partners.length){html+=`<p class="mini">Couples most with</p><ul class="coup-list">`;
    partners.slice(0,5).forEach(({m,s})=>{const pd=pairData(id,m.id);let di=0,dv=-1;LKEYS.forEach((k,i)=>{if(enabled[k]&&pd[i]>dv){dv=pd[i];di=i;}});
      html+=`<li><button data-a="${id}" data-b="${m.id}"><span style="color:${LOGICS[di].color};font-weight:800">${s}</span><span><span class="ct">${m.short}</span> <span class="cd">— ${LOGICS[di].lab.toLowerCase()}</span></span></button></li>`;});
    html+=`</ul>`;}
  const body=document.getElementById('detailBody');body.innerHTML=html;
  body.querySelectorAll('.coup-list button').forEach(b=>b.addEventListener('click',()=>selectPair(+b.dataset.a,+b.dataset.b)));
  body.querySelectorAll('.chip[data-theme]').forEach(c=>c.addEventListener('click',()=>{if(!layer.demand)setLayer('demand',true);selectTheme(+c.dataset.theme);}));
}
function stepper(a,b,i,val){return `<span class="bar-val"><button class="stp" data-a="${a}" data-b="${b}" data-i="${i}" data-d="-1">−</button>${val}<button class="stp" data-a="${a}" data-b="${b}" data-i="${i}" data-d="1">+</button></span>`}
function renderPairDetail(a,b){const A=byId[a],B=byId[b],pd=pairData(a,b),s=pairScore(a,b);document.getElementById('detailHead').textContent='Pair';
  const verdict=s>=5?'Strong tandem — viable mainly <em>together</em>.':s>=3?'Partial tandem — real shared logic, but each could stand with support.':'Weak tandem — adjacent, not interdependent.';
  let html=`<div class="node-title" style="font-size:14px"><span class="dot" style="background:${ageColor(A.age)}"></span>${A.short}<span style="color:var(--ink-faint)">+</span><span class="dot" style="background:${ageColor(B.age)}"></span>${B.short}</div>
    <p class="meta">combined ${s} / ${pairMaxEnabled()} under current logics${layer.edit?' · editing on':''}</p>
    <p class="mini">Coupling by logic</p><div class="bars">`;
  LOGICS.forEach((l,i)=>{const v=pd[i];const pct=(v/3)*100;
    html+=`<div class="bar-row"><span>${l.lab}</span><span class="bar-track"><span class="bar-fill" style="width:${pct}%;background:${l.color};opacity:${v?1:.25}"></span></span>${layer.edit?stepper(a,b,i,v):`<span class="bar-val">${v}</span>`}</div>`;});
  html+=`</div><div class="verdict">${pd[4]}</div><p style="font-size:12px;color:var(--ink-soft);margin:11px 0 0">${verdict}</p>`;
  const body=document.getElementById('detailBody');body.innerHTML=html;
  if(layer.edit)body.querySelectorAll('.stp').forEach(btn=>btn.addEventListener('click',()=>{
    const key=pairKey(+btn.dataset.a,+btn.dataset.b),i=+btn.dataset.i,d=+btn.dataset.d;
    PAIRS[key][i]=Math.max(0,Math.min(3,PAIRS[key][i]+d));refreshAll();renderPairDetail(a,b);}));
}
function renderThemeDetail(tid){const t=themeById[tid],st=themeStats[tid];document.getElementById('detailHead').textContent='Demand theme';
  let html=`<div class="node-title" style="font-size:15px">${t.name}</div>
    <p class="meta">${st.total} clusters across life-stages · ${st.founder} Founder, ${st.observed} Observed, ${st.total-st.founder-st.observed} Mentor</p>
    <p class="mini">Covered by</p><div class="chips">`;
  if(st.supply.length)st.supply.forEach(n=>html+=`<span class="chip" data-node="${n.id}">${n.short}</span>`);else html+='<span class="empty">No venture piece covers this theme.</span>';
  html+=`</div><p class="mini">The clusters underneath</p><ul class="coup-list">`;
  st.clusters.forEach(c=>{html+=`<li><button data-coord="${c.coord}"><span style="color:${STATUS_HEX[c.status]};font-weight:800">${c.coord}</span><span><span class="ct">${c.persona}</span> <span class="cd">— ${c.need}</span></span></button></li>`;});
  html+=`</ul>`;const body=document.getElementById('detailBody');body.innerHTML=html;
  body.querySelectorAll('.chip[data-node]').forEach(ch=>ch.addEventListener('click',()=>selectNode(+ch.dataset.node)));
  body.querySelectorAll('.coup-list button').forEach(b=>b.addEventListener('click',()=>selectCluster(b.dataset.coord)));
}
function renderClusterDetail(c){document.getElementById('detailHead').textContent='Cluster '+c.coord;
  const t=themeById[c.theme];const supply=themeStats[c.theme].supply;
  let html=`<div class="node-title" style="font-size:14px"><span class="dot" style="background:${STATUS_HEX[c.status]}"></span>${c.persona}</div>
    <p class="meta">${c.coord} · ${BANDS.find(x=>x.b===c.band).lab} · <b style="color:${STATUS_HEX[c.status]}">${c.status} hypothesis</b></p>
    <p class="desc-line"><b>Need:</b> ${c.need}</p>
    <p class="mini">Theme</p><div class="chips"><span class="chip" data-theme="${t.id}">${t.name}</span></div>
    <p class="mini">Pieces addressing this theme</p><div class="chips">`;
  if(supply.length)supply.forEach(n=>html+=`<span class="chip" data-node="${n.id}">${n.short}</span>`);else html+='<span class="empty">None yet — open ground.</span>';
  html+='</div>';const body=document.getElementById('detailBody');body.innerHTML=html;
  body.querySelectorAll('.chip[data-node]').forEach(ch=>ch.addEventListener('click',()=>selectNode(+ch.dataset.node)));
  body.querySelectorAll('.chip[data-theme]').forEach(ch=>ch.addEventListener('click',()=>selectTheme(+ch.dataset.theme)));
}

/* matrix */
const matrix=document.getElementById('matrix');
function mixOrange(t){return mix('#f6ead6','#F7941E',t)}
function buildMatrix(){clear(matrix);const order=NODES.map(n=>n.id);const cell=30,pad=4,labW=132,labH=100,nn=order.length;
  const w=labW+nn*(cell+pad)+10,h=labH+nn*(cell+pad)+10;matrix.setAttribute('viewBox',`0 0 ${w} ${h}`);
  const outW=Math.max(560,w);matrix.setAttribute('width',outW);matrix.setAttribute('height',h*(outW/w));
  const maxS=pairMaxEnabled();
  order.forEach((id,c)=>{const x=labW+c*(cell+pad)+cell/2;const t=el('text',{x,y:labH-8,'text-anchor':'start',class:'age-tick',transform:`rotate(-55 ${x} ${labH-8})`});t.textContent=byId[id].short;t.setAttribute('fill','var(--ink-soft)');t.setAttribute('font-weight','600');matrix.appendChild(t);});
  order.forEach((rid,r)=>{const y=labH+r*(cell+pad)+cell/2;const tl=el('text',{x:labW-8,y,'text-anchor':'end','dominant-baseline':'middle',class:'age-tick'});tl.textContent=byId[rid].short;tl.setAttribute('fill','var(--ink-soft)');tl.setAttribute('font-weight','600');matrix.appendChild(tl);
    order.forEach((cid,c)=>{if(c<=r)return;const s=pairScore(rid,cid);const x=labW+c*(cell+pad),yy=labH+r*(cell+pad);const inten=s/maxS;
      const sel=selPair&&selPair.includes(rid)&&selPair.includes(cid);
      const rect=el('rect',{x,y:yy,width:cell,height:cell,rx:6,fill:s===0?'#f6f4ef':mixOrange(inten),stroke:sel?'var(--ink)':'#efe9df','stroke-width':sel?2:1,style:'cursor:pointer'});
      rect.addEventListener('click',()=>{if(pairData(rid,cid)||layer.edit){if(!PAIRS[pairKey(rid,cid)])PAIRS[pairKey(rid,cid)]=[0,0,0,0,'(no rationale yet)'];selectPair(rid,cid);}});
      const ti=el('title',{});ti.textContent=`${byId[rid].short} + ${byId[cid].short} — ${s}`;rect.appendChild(ti);matrix.appendChild(rect);
      if(s>0){const tv=el('text',{x:x+cell/2,y:yy+cell/2+.5,'text-anchor':'middle','dominant-baseline':'middle','font-size':11,'font-weight':700,fill:inten>.55?'#fff':'var(--signal-ink)','pointer-events':'none'});tv.textContent=s;matrix.appendChild(tv);}});});
}

/* demand grid 6x8 */
const demandGrid=document.getElementById('demandGrid');
function renderGrid(){clear(demandGrid);const cols=THEMES.length,rows=BANDS.length;
  const cw=58,ch=50,pad=5,labL=118,labT=84;
  const w=labL+cols*(cw+pad)+10,h=labT+rows*(ch+pad)+54;demandGrid.setAttribute('viewBox',`0 0 ${w} ${h}`);
  const outW=Math.max(560,w);demandGrid.setAttribute('width',outW);demandGrid.setAttribute('height',h*(outW/w));
  // column headers
  THEMES.forEach((t,c)=>{const x=labL+c*(cw+pad)+cw/2;const g=el('text',{x,y:labT-10,'text-anchor':'start',class:'age-tick',transform:`rotate(-40 ${x} ${labT-10})`});g.textContent=t.short;g.setAttribute('font-weight','700');g.setAttribute('fill','var(--ink-soft)');g.style.cursor='pointer';g.addEventListener('click',()=>selectTheme(t.id));demandGrid.appendChild(g);});
  BANDS.forEach((bd,r)=>{const y=labT+r*(ch+pad)+ch/2;
    const tl=el('text',{x:labL-8,y:y-6,'text-anchor':'end','dominant-baseline':'middle',class:'age-tick'});tl.textContent=bd.b+' · '+bd.lab;tl.setAttribute('font-weight','700');tl.setAttribute('fill','var(--ink-soft)');demandGrid.appendChild(tl);
    const tl2=el('text',{x:labL-8,y:y+7,'text-anchor':'end','dominant-baseline':'middle',class:'age-tick'});tl2.textContent='~'+bd.age;demandGrid.appendChild(tl2);
    THEMES.forEach((t,c)=>{const cl=CLUSTERS.filter(x=>x.band===bd.b&&x.theme===t.id);const x=labL+c*(cw+pad),yy=labT+r*(ch+pad);
      if(!cl.length){demandGrid.appendChild(el('rect',{x,y:yy,width:cw,height:ch,rx:6,fill:'#f7f5f0',stroke:'#efe9df'}));return;}
      const main=cl[0];const covered=themeStats[t.id].supply.length>0;
      const high=selTheme===t.id;
      const rect=el('rect',{x,y:yy,width:cw,height:ch,rx:6,fill:mix('#ffffff',STATUS_HEX[main.status],.22),stroke:high?'var(--ink)':mix('#ffffff',STATUS_HEX[main.status],.5),'stroke-width':high?2:1,style:'cursor:pointer'});
      rect.addEventListener('click',()=>selectCluster(main.coord));const ti=el('title',{});ti.textContent=`${main.coord} · ${main.persona} — ${main.need} (${main.status})`;rect.appendChild(ti);demandGrid.appendChild(rect);
      const cd=el('text',{x:x+8,y:yy+16,'font-size':11,'font-weight':800,fill:STATUS_HEX[main.status]==='#b4ac9f'?'#8a826f':STATUS_HEX[main.status],'pointer-events':'none'});cd.textContent=main.coord+(cl.length>1?' +1':'');demandGrid.appendChild(cd);
      // supply indicator
      if(!covered){const g=el('text',{x:x+cw-7,y:yy+16,'text-anchor':'end','font-size':10,'font-weight':800,fill:'#c0392b','pointer-events':'none'});g.textContent='○';demandGrid.appendChild(g);}
      const nd=el('text',{x:x+7,y:yy+34,'font-size':9,fill:'var(--ink-faint)','pointer-events':'none'});nd.textContent=(main.need.length>15?main.need.slice(0,14)+'…':main.need);demandGrid.appendChild(nd);
    });});
  const foot=el('text',{x:labL,y:h-12,'font-size':10.5,fill:'var(--ink-faint)'});foot.textContent='○ = no venture piece yet covers that theme';demandGrid.appendChild(foot);
}

/* toggles */
function buildLayerToggles(){const host=document.getElementById('layerToggles');
  const items=[
   {k:'demand',lab:'Demand themes',c:'#EA3B2E',d:'Your 49 clusters → 8 need-themes; shows the coverage gaps.'},
   {k:'couplings',lab:'Couplings',c:'#F7941E',d:'Links between pieces + the tandem shortlist.'},
   {k:'willingness',lab:'Willingness (arc)',c:'#3FA845',d:'Receiver agreeing-capacity rising with need.'},
   {k:'linked',lab:'Linked lives (arc)',c:'#F7941E',d:'Buyer → recipient → next buyer; why demand regenerates.'},
   {k:'edit',lab:'Edit scores',c:'#7C4DD6',d:'Make the coupling numbers yours — steppers in the pair panel.'}
  ];
  items.forEach(it=>{const lab=document.createElement('label');lab.className='tgl';lab.dataset.k=it.k;lab.style.setProperty('--c',it.c);
    lab.innerHTML=`<input type="checkbox" ${layer[it.k]?'checked':''} aria-label="${it.lab}"><span class="swatch"></span><span class="lab">${it.lab}<span class="desc">${it.d}</span></span>`;
    lab.querySelector('input').addEventListener('change',e=>setLayer(it.k,e.target.checked));host.appendChild(lab);});
}
function buildLogicToggles(){const host=document.getElementById('logicToggles');
  LOGICS.forEach(l=>{const lab=document.createElement('label');lab.className='tgl';lab.style.setProperty('--c',l.color);
    lab.innerHTML=`<input type="checkbox" checked aria-label="${l.lab}"><span class="swatch"></span><span class="lab">${l.lab}<span class="desc">${l.desc}</span></span>`;
    lab.querySelector('input').addEventListener('change',e=>{enabled[l.key]=e.target.checked;refreshAll();});host.appendChild(lab);});
}
function setLayer(k,v){layer[k]=v;
  document.getElementById('coverageCard').style.display=layer.demand?'block':'none';
  document.getElementById('shortCard').style.display=layer.couplings?'block':'none';
  document.getElementById('logicWrap').classList.toggle('off',!layer.couplings);
  if(layer.demand)renderGrid();
  if(layer.demand&&!selTheme&&!selNode)renderCoverage();else if(layer.demand)renderCoverage();
  // sync checkbox (for programmatic calls)
  const lab=document.querySelector(`.tgl[data-k="${k}"] input`);if(lab)lab.checked=v;
  refreshAll();
}
function updateLensLocks(){
  ['willingness','linked'].forEach(k=>{const lab=document.querySelector(`.tgl[data-k="${k}"]`);if(!lab)return;
    const lock=LENS!=='arc';lab.classList.toggle('disabled',lock);lab.querySelector('input').disabled=lock;});
}
function refreshAll(){
  if(selPair)renderPairDetail(selPair[0],selPair[1]);else if(selNode)renderNodeDetail(selNode);else if(selTheme)renderThemeDetail(selTheme);
  renderShortlist();if(layer.demand){renderCoverage();renderGrid();}buildMatrix();drawOverlays();drawLinks();
}

/* lens switch */
const bArc=document.getElementById('lensArc'),bQuad=document.getElementById('lensQuad'),bChain=document.getElementById('lensChain');
function setLens(l){LENS=l;bArc.setAttribute('aria-pressed',l==='arc');bQuad.setAttribute('aria-pressed',l==='quad');bChain.setAttribute('aria-pressed',l==='chain');
  gArcBg.style.transition='opacity .4s';gQuad.style.transition='opacity .4s';gChain.style.transition='opacity .4s';
  gArcBg.style.opacity=l==='arc'?1:0;gQuad.style.opacity=l==='quad'?1:0;gChain.style.opacity=l==='chain'?1:0;
  document.getElementById('canvasHint').textContent=l==='arc'?'Lifespan arc — where each piece is delivered on the life course':l==='quad'?'Buyer quadrant — which customer each active-window piece serves':'Value chain — where each piece sits in your stakeholder stack';
  updateLensLocks();layout();}
bArc.addEventListener('click',()=>setLens('arc'));bQuad.addEventListener('click',()=>setLens('quad'));bChain.addEventListener('click',()=>setLens('chain'));

/* foot note */
document.getElementById('footNote').innerHTML='<b>How to read the merge.</b> Coupling scores are a first-pass hypothesis — turn on Edit scores and make them yours. The demand grid is your own 49 clusters, colour = your own status. Two things fall out of laying one over the other: <b>coordination &amp; oversight (theme 2) is the only all-Founder column</b> and it is well covered by supply — the validated core, which is the NRI continuum. <b>Standards/data (theme 7) is entirely Mentor-hypothesis</b>, yet it is exactly what the trust/certification hub serves — so the platform play is a structural bet, not validated pull. And <b>purpose &amp; identity (theme 6)</b> carries Founder-level conviction but is covered only by your weakest, most peripheral pieces (content, clothing, engagement) — the clearest founder-backed open ground; <b>emotional wellbeing (theme 5)</b> is high-need but you’ve logged it almost entirely as Mentor-hypothesis, so it’s unvalidated rather than proven white space.';

/* init */
initCanvas();buildLayerToggles();buildLogicToggles();buildMatrix();renderGrid();renderShortlist();
document.getElementById('coverageCard').style.display='none';
updateLensLocks();
selectPair(1,2);
</script>
