    e.leader.setAttribute('x1',(endx/dist)*rr);e.leader.setAttribute('y1',(ly/dist)*rr);e.leader.setAttribute('x2',endx);e.leader.setAttribute('y2',ly);
    e.leader.style.opacity=(Math.abs(lx)>rr+8)?.85:0;});
